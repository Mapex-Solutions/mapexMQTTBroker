###############################################################################
# MapexOS Mosquitto Broker — config template
#
# Rendered by /entrypoint.sh on container startup via envsubst. Only the
# mosquitto-native listener variables below are substituted; the rendered file
# is written to /mosquitto/config/mosquitto.conf and the broker is launched
# against it.
#
# The mapex-broker plugin reads all of its business settings (auth callout,
# NATS, TieredStore L1/L2, subjects, credentials) from the environment through
# the shared mapexGoKit config flow — see docs/config.md — not from this file.
#
# Operator MAY override (defaults applied by the entrypoint):
#   - MQTT_LISTENER_PORT             1883
#   - MQTT_MAX_CONNECTIONS           -1 (unlimited)
###############################################################################

listener ${MQTT_LISTENER_PORT}
allow_anonymous false

persistence true
persistence_location /mosquitto/data/

log_dest stdout
log_type error
log_type warning
log_type notice
log_type information

max_connections ${MQTT_MAX_CONNECTIONS}
max_inflight_messages 100
max_queued_messages 1000

###############################################################################
# mapex-broker — single plugin handling auth + ACL + presence + ingress.
#
# Auth: HTTP POST to assets MS with X-API-Key header (synchronous on
#   the broker thread; assets MS Ristretto L0 keeps warm reads <1ms).
# ACL:  pure-Go string comparison against username/topic structure.
# Presence: connect/disconnect advisories published to NATS.
# Ingress: every authorized PUBLISH forwarded to NATS with per-device
#   subject {prefix}.{orgId}.{assetUUID}.
###############################################################################
# The plugin reads all of its settings (auth callout, NATS, TieredStore
# L1/L2, subjects) from the environment through the shared mapexGoKit config
# flow — not from plugin_opt_* directives. The container env carries those
# values; see docs/config.md and the entrypoint.
plugin /usr/lib/mosquitto/mapex-broker.so
